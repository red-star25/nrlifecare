# Copy to .env.local for local development. Set the real values in the host's
# dashboard for deployed environments.

# --- Sanity CMS (product catalogue editor at /studio) ---
# Create a project at https://www.sanity.io/manage then paste the IDs here.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Editor/write token for cms:push and cms:pull (never expose to the browser).
SANITY_API_TOKEN=

# Auto-sync: Sanity publish → /api/cms-webhook → GitHub cms-pull Action
SANITY_WEBHOOK_SECRET=
GH_DISPATCH_TOKEN=
# GH_REPO=red-star25/nrlifecare


# --- Enquiry form (Resend) ---
RESEND_API_KEY=
ENQUIRY_TO=
ENQUIRY_FROM=

# --- Site URL ---
# Leave unset on Vercel preview deployments. Set to the live domain in production.
NEXT_PUBLIC_SITE_URL=

# Legacy Google Sheet sync (retired once Sanity is live).
CATALOG_CSV_URL=
