# Copy to .env.local for local development. Set the real values in the host's
# dashboard for deployed environments. See README.md → "The enquiry form".

# Required for the contact form to deliver. https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries land. Defaults to company.email if unset.
ENQUIRY_TO=

# Sender address. Until nrlifecare.com is verified in Resend, leave this unset
# and mail is sent from Resend's shared onboarding@resend.dev, which only
# delivers to the Resend account owner's own address.
ENQUIRY_FROM=

# The canonical origin for this deployment. Leave unset on Vercel — it falls
# back to the deployment URL and marks the site noindex, which is what a
# staging copy should do. Set it to https://www.nrlifecare.com in production.
NEXT_PUBLIC_SITE_URL=

# Published-to-CSV URL of the product catalogue Google Sheet. Used only by the
# sync workflow, which reads it from the CATALOG_CSV_URL GitHub secret.
CATALOG_CSV_URL=
